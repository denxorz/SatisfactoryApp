@using SatisfactoryApp.Services.Machines
@implements IDisposable
@inject MachineStore MachineStore

<MudCard Outlined="true" Square="true" Class="border-solid border-4 mud-border-primary">
    <MudCardHeader Class="mud-primary pa-0 pl-1">
        <MudText Class="primary-card-header-title">Machine Filters</MudText>
    </MudCardHeader>
    <MudCardContent Class="pa-2">
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudComboBox 
                    T="MachineTypeOption"
                    @bind-SelectedValues="@MachineStore.SelectedMachineTypes"
                    Variant="Variant.Outlined"
                    MultiSelection
                    Label="Type" 
                    Editable
                    Clearable
                    SelectAll
                    ShowCheckbox>
                    @foreach (var item in MachineTypeOptions)
                    {
                        <MudComboBoxItem Value="@item" Text="@item.Title"></MudComboBoxItem>
                    }
                </MudComboBox>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudComboBox T="PowerCircuitOption"
                             @bind-SelectedValues="@MachineStore.SelectedPowerCircuits"
                             Variant="Variant.Outlined"
                             MultiSelection
                             Label="Power Circuit"
                             Editable
                             Clearable
                             SelectAll
                             ShowCheckbox>
                    @foreach (var item in PowerCircuitIdOptions)
                    {
                        <MudComboBoxItem Value="@item" Text="@item.ToString()"></MudComboBoxItem>
                    }
                </MudComboBox>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudComboBox T="MachineStabilityOption"
                             @bind-SelectedValues="@MachineStore.SelectedMachineStabilities"
                             Variant="Variant.Outlined"
                             MultiSelection
                             Label="Stability"
                             Editable
                             Clearable
                             SelectAll
                             ShowCheckbox>
                    @foreach (var item in MachineStabilityOptions)
                    {
                        <MudComboBoxItem Value="@item" Text="@item.ToString()"></MudComboBoxItem>
                    }
                </MudComboBox>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {

    private List<MachineTypeOption> MachineTypeOptions = [];
    private List<PowerCircuitOption> PowerCircuitIdOptions = [];
    private List<MachineStabilityOption> MachineStabilityOptions = [];

    protected override void OnInitialized() 
    {
        MachineStore.FactoriesChanged += OnChanged;
        Load();
    }

    private void OnChanged()
    {
        Load();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Load()
    {
        MachineTypeOptions = MachineStore.MachineTypeOptions;
        PowerCircuitIdOptions = MachineStore.PowerCircuitIdOptions;
        MachineStabilityOptions = MachineStore.MachineStabilityOptions;
    }

    public void Dispose()
    {
        MachineStore.FactoriesChanged -= OnChanged;
    }
}
