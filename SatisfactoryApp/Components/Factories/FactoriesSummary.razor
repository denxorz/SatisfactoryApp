@code {
    private List<CircuitInputOutputStat> _circuitInputOutputStats = [];
    private Dictionary<int, PowerCircuitStat> _powerMainCircuitStats = [];
    private IGrouping<string, CircuitInputOutputStat>[] _groupedStats = [];
    private Dictionary<string, Dictionary<string, int>> _groupMachineTypeCounts = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, GroupSummaryStats> _groupSummaryStats = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, (int Trains, int Trucks, int Drones)> _groupStationCounts = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, List<Station>> _groupStations = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        MachineStore.FactoriesChanged += UpdateStats;
        StationStore.StationsChanged += UpdateStats;
        UpdateStats();
    }

    public void Dispose()
    {
        MachineStore.FactoriesChanged -= UpdateStats;
        StationStore.StationsChanged -= UpdateStats;
    }

    private void UpdateStats()
    {
        var mainCircuitStats = new Dictionary<int, PowerCircuitStat>();
        var circuitItemStats = new Dictionary<(int CircuitId, string ItemName), (double Consumed, double Produced)>();

        foreach (var circuit in MachineStore.PowerCircuits)
        {
            if (circuit.ParentCircuitId is null)
            {
                mainCircuitStats[circuit.Id] = new PowerCircuitStat
                {
                    CircuitId = circuit.Id,
                    CircuitName = CircuitNames.GetName(circuit)
                };
            }
        }

        foreach (var factory in MachineStore.Factories)
        {
            var clockSpeedMultiplier = (factory.ClockSpeed ?? 100) / 100;
            var sloopMultiplier = factory.HasSloop ? 2.0 : 1.0;
            var totalMultiplier = clockSpeedMultiplier * sloopMultiplier;

            var circuitsToProcess = new List<int>
            {
                factory.MainPowerCircuitId,
                factory.SubPowerCircuitId
            };

            foreach (var circuitId in circuitsToProcess)
            {
                foreach (var consumed in factory.Input)
                {
                    var itemName = GetItemName(consumed);
                    var amount = GetItemAmount(consumed) * totalMultiplier;

                    var key = (circuitId, itemName);
                    if (!circuitItemStats.ContainsKey(key))
                    {
                        circuitItemStats[key] = (0, 0);
                    }
                    var current = circuitItemStats[key];
                    circuitItemStats[key] = (current.Consumed + amount, current.Produced);
                }

                foreach (var output in factory.Output)
                {
                    var itemName = GetItemName(output);
                    var amount = GetItemAmount(output) * totalMultiplier;

                    var key = (circuitId, itemName);
                    if (!circuitItemStats.ContainsKey(key))
                    {
                        circuitItemStats[key] = (0, 0);
                    }
                    var current = circuitItemStats[key];
                    circuitItemStats[key] = (current.Consumed, current.Produced + amount);
                }
            }
        }

        var subCircuitIdByCleanedName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var circuit in MachineStore.PowerCircuits)
        {
            if (circuit.ParentCircuitId is null) continue;
            var cleaned = RemoveBrackets(CircuitNames.GetName(circuit)).Trim();
            if (string.IsNullOrEmpty(cleaned)) continue;
            if (!subCircuitIdByCleanedName.ContainsKey(cleaned))
                subCircuitIdByCleanedName[cleaned] = circuit.Id;
        }

        foreach (var station in StationStore.Stations)
        {
            if (station?.CargoFlows == null || station.CargoFlows.Count == 0)
                continue;

            var stationName = (station.Name ?? "").Trim();
            var stationShortName = (station.ShortName ?? "").Trim();
            if (string.IsNullOrEmpty(stationName) && string.IsNullOrEmpty(stationShortName))
                continue;

            if (!subCircuitIdByCleanedName.TryGetValue(stationName, out var circuitId)
                && !subCircuitIdByCleanedName.TryGetValue(stationShortName, out circuitId))
                continue;

            foreach (var flow in station.CargoFlows)
            {
                if (flow == null || string.IsNullOrEmpty(flow.Type) || !flow.FlowPerMinute.HasValue)
                    continue;
                var itemName = flow.Type;
                var amount = flow.FlowPerMinute.Value;
                var key = (circuitId, itemName);
                if (!circuitItemStats.ContainsKey(key))
                    circuitItemStats[key] = (0, 0);
                var current = circuitItemStats[key];
                if (flow.IsUnload)
                    circuitItemStats[key] = (current.Consumed, current.Produced + amount);
                else
                    circuitItemStats[key] = (current.Consumed + amount, current.Produced);
            }
        }

        _powerMainCircuitStats = mainCircuitStats;

        var groupMachineTypeCounts = new Dictionary<string, Dictionary<string, int>>(StringComparer.OrdinalIgnoreCase);

        void AddFactoryToGroup(string groupKey, string? factoryType)
        {
            if (string.IsNullOrWhiteSpace(groupKey))
                return;

            var type = string.IsNullOrWhiteSpace(factoryType) ? "Unknown" : factoryType!;
            if (!groupMachineTypeCounts.TryGetValue(groupKey, out var typeCounts))
            {
                typeCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
                groupMachineTypeCounts[groupKey] = typeCounts;
            }

            typeCounts.TryGetValue(type, out var count);
            typeCounts[type] = count + 1;
        }

        foreach (var factory in MachineStore.Factories)
        {
            AddFactoryToGroup($"MAIN_{factory.MainPowerCircuitId}", factory.Type);

            var subCircuit = MachineStore.PowerCircuits.FirstOrDefault(c => c.Id == factory.SubPowerCircuitId);
            if (subCircuit?.ParentCircuitId is not null)
            {
                var cleaned = RemoveBrackets(CircuitNames.GetName(subCircuit));
                if (!string.IsNullOrWhiteSpace(cleaned))
                {
                    AddFactoryToGroup($"SUB_{cleaned}", factory.Type);
                }
            }
        }

        _groupMachineTypeCounts = groupMachineTypeCounts;

        var combinedStats = new Dictionary<(string GroupKey, string ItemName), (double Consumed, double Produced, int? FirstCircuitId, int? ParentCircuitId, bool IsMainCircuit)>();

        foreach (var kvp in circuitItemStats)
        {
            var (circuitId, itemName) = kvp.Key;
            var (consumed, produced) = kvp.Value;
            var circuit = MachineStore.PowerCircuits.FirstOrDefault(c => c.Id == circuitId);
            var parentId = circuit?.ParentCircuitId;
            var isMainCircuit = parentId is null;

            string groupKey;
            if (isMainCircuit)
            {
                groupKey = $"MAIN_{circuitId}";
            }
            else
            {
                var circuitName = CircuitNames.GetName(circuit);
                var cleanedName = RemoveBrackets(circuitName);
                groupKey = $"SUB_{cleanedName}";
            }

            var combinedKey = (groupKey, itemName);
            if (!combinedStats.ContainsKey(combinedKey))
            {
                combinedStats[combinedKey] = (0, 0, circuitId, parentId, isMainCircuit);
            }
            var current = combinedStats[combinedKey];
            combinedStats[combinedKey] = (current.Consumed + consumed, current.Produced + produced, current.FirstCircuitId, current.ParentCircuitId, current.IsMainCircuit);
        }

        _circuitInputOutputStats = combinedStats
            .Select(kvp =>
            {
                var ((groupKey, itemName), (consumed, produced, firstCircuitId, parentId, isMainCircuit)) = kvp;
                var circuit = MachineStore.PowerCircuits.FirstOrDefault(c => c.Id == firstCircuitId);

                return new CircuitInputOutputStat
                {
                    CircuitId = firstCircuitId ?? 0,
                    CircuitName = isMainCircuit ? CircuitNames.GetName(circuit) : RemoveBrackets(CircuitNames.GetName(circuit)),
                    ParentCircuitId = parentId,
                    ItemName = itemName,
                    TotalConsumed = consumed,
                    TotalProduced = produced,
                    GroupKey = groupKey,
                    IsMainCircuit = isMainCircuit
                };
            })
            .OrderBy(s => s.IsMainCircuit ? 0 : 1)
            .ThenBy(s => s.GroupKey)
            .ThenBy(s => s.ItemName)
            .ToList();

        var mainCircuitSubCount = new Dictionary<int, int>();
        foreach (var c in MachineStore.PowerCircuits)
        {
            if (c.ParentCircuitId is int parentId)
                mainCircuitSubCount[parentId] = mainCircuitSubCount.GetValueOrDefault(parentId, 0) + 1;
        }

        _groupedStats = _circuitInputOutputStats
            .Where(s => !s.IsMainCircuit || mainCircuitSubCount.GetValueOrDefault(s.CircuitId, 0) <= 1)
            .GroupBy(s => s.GroupKey)
            .OrderBy(g => _circuitInputOutputStats.First(x => x.GroupKey == g.Key).IsMainCircuit ? 0 : 1)
            .ThenBy(g => g.Key)
            .ToArray();

        var groupSummaryStats = new Dictionary<string, GroupSummaryStats>(StringComparer.OrdinalIgnoreCase);
        foreach (var g in _groupedStats)
        {
            var groupKey = g.Key;
            var factories = GetFactoriesForGroup(groupKey);
            var total = factories.Count;
            var notStable = factories.Count(f => f.PercentageProducing is not null && f.PercentageProducing != 100);
            var variablePower = factories.Count(f => f.IsVariablePower());
            var powerStorage = factories.Count(f => f.IsPowerStorage());
            var powerGenerator = factories.Count(f => f.IsPowerProducerStorage());
            groupSummaryStats[groupKey] = new GroupSummaryStats
            {
                Total = total,
                IsStable = notStable == 0 && variablePower == 0,
                NumberOfNotStable = notStable,
                NumberOfVariablePower = variablePower,
                NumberOfPowerStorage = powerStorage,
                NumberOfPowerGenerator = powerGenerator,
                NumberOfResourceSinks = factories.Count(f => string.Equals(f.Type, "ResourceSink", StringComparison.OrdinalIgnoreCase))
            };
        }
        _groupSummaryStats = groupSummaryStats;

        var groupStationCounts = new Dictionary<string, (int Trains, int Trucks, int Drones)>(StringComparer.OrdinalIgnoreCase);
        var groupStations = new Dictionary<string, List<Station>>(StringComparer.OrdinalIgnoreCase);
        foreach (var g in _groupedStats)
        {
            groupStationCounts[g.Key] = (0, 0, 0);
            groupStations[g.Key] = [];
        }

        HashSet<int> GetCircuitIdsForGroup(string groupKey)
        {
            if (groupKey.StartsWith("MAIN_"))
            {
                var mainId = int.Parse(groupKey.Substring(5));
                return MachineStore.PowerCircuits
                    .Where(c => c.ParentCircuitId == mainId)
                    .Select(c => c.Id)
                    .ToHashSet();
            }
            if (groupKey.StartsWith("SUB_"))
            {
                var cleanedName = groupKey.Substring(4);
                return MachineStore.PowerCircuits
                    .Where(c => c.ParentCircuitId is not null && RemoveBrackets(CircuitNames.GetName(c)) == cleanedName)
                    .Select(c => c.Id)
                    .ToHashSet();
            }
            return [];
        }

        foreach (var station in StationStore.Stations)
        {
            if (station?.CargoFlows == null || station.CargoFlows.Count == 0)
                continue;
            var stationName = (station.Name ?? "").Trim();
            var stationShortName = (station.ShortName ?? "").Trim();
            if (string.IsNullOrEmpty(stationName) && string.IsNullOrEmpty(stationShortName))
                continue;
            if (!subCircuitIdByCleanedName.TryGetValue(stationName, out var circuitId)
                && !subCircuitIdByCleanedName.TryGetValue(stationShortName, out circuitId))
                continue;
            var stationType = (station.Type ?? "").Trim().ToLowerInvariant();
            foreach (var groupKey in groupStationCounts.Keys.ToList())
            {
                var circuitIds = GetCircuitIdsForGroup(groupKey);
                if (!circuitIds.Contains(circuitId))
                    continue;
                var (trains, trucks, drones) = groupStationCounts[groupKey];
                if (stationType == "train") trains++;
                else if (stationType == "truck") trucks++;
                else if (stationType == "drone") drones++;
                groupStationCounts[groupKey] = (trains, trucks, drones);
                groupStations[groupKey].Add(station);
            }
        }
        _groupStationCounts = groupStationCounts;
        _groupStations = groupStations;

        StateHasChanged();
    }

    private List<Factory> GetFactoriesForGroup(string groupKey)
    {
        if (groupKey.StartsWith("MAIN_"))
        {
            var circuitId = int.Parse(groupKey.Substring(5));
            return MachineStore.Factories.Where(f => f.MainPowerCircuitId == circuitId).ToList();
        }
        if (groupKey.StartsWith("SUB_"))
        {
            var cleanedName = groupKey.Substring(4);
            var circuitIds = MachineStore.PowerCircuits
                .Where(c => c.ParentCircuitId is not null && RemoveBrackets(CircuitNames.GetName(c)) == cleanedName)
                .Select(c => c.Id)
                .ToHashSet();
            return MachineStore.Factories.Where(f => circuitIds.Contains(f.SubPowerCircuitId)).ToList();
        }
        return [];
    }

    private GroupSummaryStats GetGroupSummaryStats(string groupKey)
    {
        return _groupSummaryStats.TryGetValue(groupKey, out var s) ? s : new GroupSummaryStats();
    }

    private (int Trains, int Trucks, int Drones) GetGroupStationCounts(string groupKey)
    {
        return _groupStationCounts.TryGetValue(groupKey, out var c) ? c : (0, 0, 0);
    }

    private IReadOnlyList<Station> GetGroupStations(string groupKey)
    {
        return _groupStations.TryGetValue(groupKey, out var list) ? list : Array.Empty<Station>();
    }

    private string GetGroupDisplayName(string groupKey)
    {
        var chips = GetGroupCircuitChips(groupKey);
        return chips.Count > 0 ? string.Join(", ", chips) : "[Unknown Circuit]";
    }

    private List<string> GetGroupCircuitChips(string groupKey)
    {
        if (groupKey.StartsWith("MAIN_"))
        {
            var circuitId = int.Parse(groupKey.Substring(5));
            var mainCircuit = _powerMainCircuitStats.GetValueOrDefault(circuitId);
            return mainCircuit != null
                ? [$"[{mainCircuit.CircuitId}] {mainCircuit.CircuitName}"]
                : ["[Unknown Main Circuit]"];
        }
        if (groupKey.StartsWith("SUB_"))
        {
            var cleanedName = groupKey.Substring(4);
            var subCircuits = MachineStore.PowerCircuits
                .Where(c => c.ParentCircuitId is not null && RemoveBrackets(CircuitNames.GetName(c)) == cleanedName)
                .ToList();
            return subCircuits.Any()
                ? subCircuits.Select(c => CircuitNames.GetIdAndName(c)).ToList()
                : [cleanedName];
        }
        return [];
    }

    private string GetGroupTitle(string groupKey)
    {
        string? title = null;
        if (groupKey.StartsWith("MAIN_"))
        {
            var circuitId = int.Parse(groupKey.Substring(5));
            var mainCircuit = _powerMainCircuitStats.GetValueOrDefault(circuitId);
            title = mainCircuit?.CircuitName;
        }
        else if (groupKey.StartsWith("SUB_"))
        {
            title = groupKey.Substring(4);
        }
        return string.IsNullOrWhiteSpace(title) ? "Unknown" : title;
    }

    private IReadOnlyList<KeyValuePair<string, int>> GetMachineSummary(string groupKey)
    {
        if (_groupMachineTypeCounts.TryGetValue(groupKey, out var dict))
        {
            return dict
                .OrderByDescending(kvp => kvp.Value)
                .ThenBy(kvp => kvp.Key)
                .ToList();
        }

        return Array.Empty<KeyValuePair<string, int>>();
    }

    private const int MapMinX = -320000;
    private const int MapMaxX = 425000;
    private const int MapMinY = -380000;
    private const int MapMaxY = 375000;
    private const int MapSize = 30;

    private (double x, double y)? GetGroupMeanPosition(string groupKey)
    {
        var factories = GetFactoriesForGroup(groupKey);
        if (factories.Count == 0) return null;
        double sumX = 0, sumY = 0;
        int n = 0;
        foreach (var f in factories)
        {
            sumX += f.X;
            sumY += f.Y;
            n++;
        }
        if (n == 0) return null;
        return (sumX / n, sumY / n);
    }

    private static string CreateMiniMapSvg(double worldX, double worldY)
    {
        var scaleX = MapSize / (double)(MapMaxX - MapMinX);
        var scaleY = MapSize / (double)(MapMaxY - MapMinY);
        var sx = (worldX - MapMinX) * scaleX;
        var sy = (worldY - MapMinY) * scaleY;
        var cx = Math.Clamp(sx, 0, MapSize);
        var cy = Math.Clamp(sy, 0, MapSize);
        var r = 0.8;
        return $"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {MapSize} {MapSize}\" preserveAspectRatio=\"none\"><circle cx=\"{cx.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" cy=\"{cy.ToString(System.Globalization.CultureInfo.InvariantCulture)}\" r=\"{r}\" fill=\"#e59345\" stroke=\"#1a1a1a\" stroke-width=\"0.4\"/></svg>";
    }

    private string GetItemName(FactoryFlow flow)
    {
        return flow.Type;
    }

    private double GetItemAmount(FactoryFlow flow)
    {
        return flow.FlowPerMinute ?? 0;
    }

    private string RemoveBrackets(string name)
    {
        if (string.IsNullOrEmpty(name))
            return name;

        var result = System.Text.RegularExpressions.Regex.Replace(name, "\\s*\\[.*?\\]\\s*", " ");
        return System.Text.RegularExpressions.Regex.Replace(result, "\\s+", " ").Trim();
    }

    private static string GetItemColor(string itemName)
    {
        if (string.IsNullOrEmpty(itemName)) return "#888";
        var key = new string(itemName.Where(c => char.IsLetterOrDigit(c)).ToArray()).ToLowerInvariant();
        return CargoColors.GetCargoColor(key);
    }

    private sealed class CircuitInputOutputStat
    {
        public int CircuitId { get; set; }
        public string CircuitName { get; set; } = string.Empty;
        public int? ParentCircuitId { get; set; }
        public string ItemName { get; set; } = string.Empty;
        public double TotalConsumed { get; set; }
        public double TotalProduced { get; set; }
        public double Net => TotalProduced - TotalConsumed;
        public string GroupKey { get; set; } = string.Empty;
        public bool IsMainCircuit { get; set; }
    }

    private sealed class PowerCircuitStat
    {
        public int CircuitId { get; set; }
        public string CircuitName { get; set; } = string.Empty;
    }

    private sealed class GroupSummaryStats
    {
        public int Total { get; set; }
        public bool IsStable { get; set; }
        public int NumberOfNotStable { get; set; }
        public int NumberOfVariablePower { get; set; }
        public int NumberOfPowerStorage { get; set; }
        public int NumberOfPowerGenerator { get; set; }
        public int NumberOfResourceSinks { get; set; }
    }
}
