@using Denxorz.Satisfactory.Routes.Types
@using MudBlazor
@using SatisfactoryApp.Components
@using SatisfactoryApp.Services.Machines
@using SatisfactoryApp.Services.Stations
@using SatisfactoryApp.Utils
@inject MachineStore MachineStore
@inject StationStore StationStore
@implements IDisposable

<MudStack Spacing="2">
            @foreach (var group in _groupedStats)
            {
                <MudCard Outlined="true" Square="true" Class="border-solid border-4 mud-border-primary io-card">
                    <MudCardHeader Class="mud-primary pa-0 pl-1">
                        <MudText Class="primary-card-header-title" Color="Color.Surface">@GetGroupTitle(group.Key)</MudText>
                    </MudCardHeader>
                    <MudCardContent Class="pa-2 io-card-content">
                        @{
                            var summary = GetGroupSummaryStats(group.Key);
                            var hasImports = group.Any(s => s.Net < -0.001);
                            var hasExports = group.Any(s => s.Net > 0.001);
                            var meanPos = GetGroupMeanPosition(group.Key);
                            var transportCounts = GetGroupStationCounts(group.Key);
                        }
                        <div class="io-card-summary-icons">
                            @if (meanPos.HasValue)
                            {
                                <div class="io-mini-map-wrap">
                                    <div class="io-mini-map">
                                        <img src="/images/1920px-Biome_Map.jpg" alt="" class="io-mini-map-bg" />
                                        @((MarkupString)CreateMiniMapSvg(meanPos.Value.x, meanPos.Value.y))
                                    </div>
                                </div>
                            }
                            <div class="io-card-summary-icons-list">
                                <div class="io-summary-chip-card">
                                    <div class="io-summary-chips">
                                        <MudTooltip Text="@(summary.IsStable ? "Power usage is stable" : $"{summary.NumberOfNotStable} not running at 100%")">
                                            <div class="io-summary-chip">
                                                <MudIcon Icon="@(MudBlazor.FontIcons.MaterialSymbols.Outlined.CheckCircle)" Color="Color.Success" Size="Size.Medium" Class="@(!summary.IsStable ? "io-header-icon-faded" : "")" />
                                                <span class="io-summary-chip-label">Stable</span>
                                            </div>
                                        </MudTooltip>
                                        <MudTooltip Text="@($"{summary.NumberOfVariablePower} variable power")">
                                            <div class="io-summary-chip">
                                                <MudIcon Icon="@(MudBlazor.FontIcons.MaterialSymbols.Outlined.ShowChart)" Color="Color.Primary" Size="Size.Medium" Class="@(summary.NumberOfVariablePower == 0 ? "io-header-icon-faded" : "")" />
                                                <span class="io-summary-chip-label">Variable</span>
                                            </div>
                                        </MudTooltip>
                                        <MudTooltip Text="@($"{summary.NumberOfPowerStorage} power storage(s)")">
                                            <div class="io-summary-chip">
                                                <MudIcon Icon="@(MudBlazor.FontIcons.MaterialSymbols.Outlined.Battery6Bar)" Color="Color.Info" Size="Size.Medium" Class="@(summary.NumberOfPowerStorage == 0 ? "io-header-icon-faded" : "")" />
                                                <span class="io-summary-chip-label">Storage</span>
                                            </div>
                                        </MudTooltip>
                                        <MudTooltip Text="@($"{summary.NumberOfPowerGenerator} generator(s)")">
                                            <div class="io-summary-chip">
                                                <MudIcon Icon="@(MudBlazor.FontIcons.MaterialSymbols.Outlined.EvStation)" Color="Color.Info" Size="Size.Medium" Class="@(summary.NumberOfPowerGenerator == 0 ? "io-header-icon-faded" : "")" />
                                                <span class="io-summary-chip-label">Generators</span>
                                            </div>
                                        </MudTooltip>
                                        <MudTooltip Text="@(summary.NumberOfResourceSinks > 0 ? $"{summary.NumberOfResourceSinks} Resource Sink(s)" : "No Resource Sink")">
                                            <div class="io-summary-chip">
                                                <MudIcon Icon="@(MudBlazor.FontIcons.MaterialSymbols.Outlined.Faucet)"
                                                         Color="@(summary.NumberOfResourceSinks > 0 ? Color.Primary : Color.Default)"
                                                         Size="Size.Medium"
                                                         Class="@(summary.NumberOfResourceSinks == 0 ? "io-header-icon-faded" : "")" />
                                                <span class="io-summary-chip-label">Has sink</span>
                                            </div>
                                        </MudTooltip>
                                        <MudTooltip Text="@($"{transportCounts.Trains} train station(s)")">
                                            <div class="io-summary-chip">
                                                <MudIcon Icon="@(MudBlazor.FontIcons.MaterialSymbols.Outlined.Monorail)"
                                                         Color="Color.Info"
                                                         Size="Size.Medium"
                                                         Class="@(transportCounts.Trains == 0 ? "io-header-icon-faded" : "")" />
                                                <span class="io-summary-chip-label">Trains</span>
                                            </div>
                                        </MudTooltip>
                                        <MudTooltip Text="@($"{transportCounts.Trucks} truck station(s)")">
                                            <div class="io-summary-chip">
                                                <MudIcon Icon="@(MudBlazor.FontIcons.MaterialSymbols.Outlined.LocalShipping)"
                                                         Color="Color.Info"
                                                         Size="Size.Medium"
                                                         Class="@(transportCounts.Trucks == 0 ? "io-header-icon-faded" : "")" />
                                                <span class="io-summary-chip-label">Trucks</span>
                                            </div>
                                        </MudTooltip>
                                        <MudTooltip Text="@($"{transportCounts.Drones} drone station(s)")">
                                            <div class="io-summary-chip">
                                                <MudIcon Icon="@(MudBlazor.FontIcons.MaterialSymbols.Outlined.Flight)"
                                                         Color="Color.Info"
                                                         Size="Size.Medium"
                                                         Class="@(transportCounts.Drones == 0 ? "io-header-icon-faded" : "")" />
                                                <span class="io-summary-chip-label">Drones</span>
                                            </div>
                                        </MudTooltip>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @{
                            var netDeficitItems = group.Where(s => s.Net < -0.001).OrderBy(s => s.ItemName).ToList();
                            var netSurplusItems = group.Where(s => s.Net > 0.001).OrderBy(s => s.ItemName).ToList();
                        }
                        <MudGrid Class="io-imports-exports-row">
                            <MudItem xs="12" md="6">
                                <div class="io-imports-exports-block io-imports">
                                    <MudText Typo="Typo.subtitle1" Class="io-imports-exports-title">
                                        <MudIcon Icon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.Download" Size="Size.Small" Class="mr-1" />
                                        Imports
                                    </MudText>
                                    @if (netDeficitItems.Any())
                                    {
                                        <div class="io-item-list io-item-list-prominent">
                                            @foreach (var s in netDeficitItems)
                                            {
                                                var iconUrl = ResourceDisplayNames.GetItemIconUrl(s.ItemName);
                                                <div class="io-item io-item-prominent">
                                                    @if (!string.IsNullOrEmpty(iconUrl))
                                                    {
                                                        <img class="io-item-icon" src="@iconUrl" alt="" title="@ResourceDisplayNames.GetDisplayName(s.ItemName)" />
                                                    }
                                                    else
                                                    {
                                                        <span class="io-item-icon io-item-icon-fallback" style="background: @GetItemColor(s.ItemName);" title="@ResourceDisplayNames.GetDisplayName(s.ItemName)"></span>
                                                    }
                                                    <span class="io-item-text">@ResourceDisplayNames.GetDisplayName(s.ItemName)</span>
                                                    <span class="io-item-amount">@(Math.Round(-s.Net, 3).ToString("0.###"))/m</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="io-imports-exports-empty">—</MudText>
                                    }
                                </div>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <div class="io-imports-exports-block io-exports">
                                    <MudText Typo="Typo.subtitle1" Class="io-imports-exports-title">
                                        <MudIcon Icon="@MudBlazor.FontIcons.MaterialSymbols.Outlined.Upload" Size="Size.Small" Class="mr-1" />
                                        @(summary.NumberOfResourceSinks > 0 ? "Exports or sinks" : "Exports")
                                    </MudText>
                                    @if (netSurplusItems.Any())
                                    {
                                        <div class="io-item-list io-item-list-prominent">
                                            @foreach (var s in netSurplusItems)
                                            {
                                                var iconUrl = ResourceDisplayNames.GetItemIconUrl(s.ItemName);
                                                <div class="io-item io-item-prominent">
                                                    @if (!string.IsNullOrEmpty(iconUrl))
                                                    {
                                                        <img class="io-item-icon" src="@iconUrl" alt="" title="@ResourceDisplayNames.GetDisplayName(s.ItemName)" />
                                                    }
                                                    else
                                                    {
                                                        <span class="io-item-icon io-item-icon-fallback" style="background: @GetItemColor(s.ItemName);" title="@ResourceDisplayNames.GetDisplayName(s.ItemName)"></span>
                                                    }
                                                    <span class="io-item-text">@ResourceDisplayNames.GetDisplayName(s.ItemName)</span>
                                                    <span class="io-item-amount">@(Math.Round(s.Net, 3).ToString("0.###"))/m</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="io-imports-exports-empty">—</MudText>
                                    }
                                </div>
                            </MudItem>
                        </MudGrid>
                        <div class="io-meta-blocks">
                            <div class="io-meta-block io-meta-block-circuits">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="io-meta-block-label">Circuits</MudText>
                                @{
                                    var circuitChips = GetGroupCircuitChips(group.Key);
                                }
                                @if (circuitChips.Count > 0)
                                {
                                    <div class="io-circuit-chips">
                                        @foreach (var name in circuitChips)
                                        {
                                            <span class="io-circuit-chip">@name</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="io-meta-block-empty">—</MudText>
                                }
                            </div>
                            @{
                                var machineSummary = GetMachineSummary(group.Key);
                            }
                            <div class="io-meta-block io-meta-block-machines">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="io-meta-block-label">Machines</MudText>
                                @if (machineSummary.Count > 0)
                                {
                                    <div class="io-machines-list">
                                        @foreach (var kvp in machineSummary.Take(10))
                                        {
                                            var typeKey = kvp.Key;
                                            var count = kvp.Value;
                                            var machineName = ResourceDisplayNames.GetDisplayName(typeKey);
                                            var iconUrl = ResourceDisplayNames.GetItemIconUrl(typeKey);
                                            <div class="io-machine-chip">
                                                @if (!string.IsNullOrEmpty(iconUrl))
                                                {
                                                    <img class="io-machine-chip-icon" src="@iconUrl" alt="" title="@machineName" />
                                                }
                                                else
                                                {
                                                    <span class="io-machine-chip-icon io-machine-chip-icon-fallback" title="@machineName"></span>
                                                }
                                                <span class="io-machine-chip-text">@(count)× @machineName</span>
                                            </div>
                                        }
                                        @if (machineSummary.Count > 10)
                                        {
                                            <span class="io-machine-chip-more">+@(machineSummary.Count - 10) more</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="io-meta-block-empty">—</MudText>
                                }
                            </div>
                            <div class="io-meta-block io-meta-block-transport">
                                @{
                                    var transportStations = GetGroupStations(group.Key);
                                    var transportVehicles = transportStations
                                        .Where(s => s.Transporters != null && s.Transporters.Count > 0)
                                        .SelectMany(s => s.Transporters.Select(v => (Station: s, Vehicle: v)))
                                        .OrderBy(p => p.Vehicle.Name ?? p.Vehicle.Id)
                                        .ToList();
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="io-meta-block-label">Transport arrivals</MudText>
                                @if (transportVehicles.Count > 0)
                                {
                                    <div class="io-transport-list">
                                        @foreach (var entry in transportVehicles)
                                        {
                                            var station = entry.Station;
                                            var vehicle = entry.Vehicle;
                                            var stationType = (station.Type ?? "").Trim().ToLowerInvariant();
                                            var icon = stationType == "train"
                                                ? MudBlazor.FontIcons.MaterialSymbols.Outlined.Monorail
                                                : stationType == "truck"
                                                    ? MudBlazor.FontIcons.MaterialSymbols.Outlined.LocalShipping
                                                    : MudBlazor.FontIcons.MaterialSymbols.Outlined.Flight;
                                            <div class="io-transport-row">
                                                <MudIcon Icon="@icon" Size="Size.Small" Color="Color.Info" />
                                                <span class="io-transport-name">@vehicle.Name</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="io-meta-block-empty">—</MudText>
                                }
                            </div>
                        </div>
                        <MudExpansionPanels Class="io-details-panels">
                            <MudExpansionPanel Text="More production details" IsInitiallyExpanded="false" Class="io-details-panel">
                                <MudTable Items="@group" Hover Dense Striped Breakpoint="Breakpoint.Sm" Class="mud-table-dense">
                            <HeaderContent>
                                <MudTh>Item</MudTh>
                                <MudTh Style="text-align: right">Consumed</MudTh>
                                <MudTh Style="text-align: right">Produced</MudTh>
                                <MudTh Style="text-align: right">Net</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Item">@ResourceDisplayNames.GetDisplayName(context.ItemName)</MudTd>
                                <MudTd DataLabel="Consumed" Style="text-align: right">
                                    <MudText Color="@(-context.TotalConsumed < -0.001 ? Color.Error : Color.Default)">
                                        @(Math.Round(-context.TotalConsumed, 3).ToString("0.###"))
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="Produced" Style="text-align: right">
                                    @(Math.Round(context.TotalProduced, 3).ToString("0.###"))
                                </MudTd>
                                <MudTd DataLabel="Net" Style="text-align: right">
                                    @{
                                        var net = Math.Round(context.Net, 3);
                                    }
                                    <MudText Color="@(context.Net < -0.001 ? Color.Error : context.Net > 0.001 ? Color.Success : Color.Default)">
                                        @(net == 0 ? "0" : net.ToString("0.###"))
                                    </MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>

<style>
    .io-card-content {
        padding: 12px 16px;
    }
    .io-card-summary-icons {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.08));
    }
    .io-card-summary-icons-list {
        display: flex;
        align-items: center;
        gap: 4px 2px;
        flex-wrap: wrap;
    }
    .io-summary-chip-card {
        padding: 10px 14px;
        min-height: 72px;
        display: flex;
        align-items: center;
        background: var(--mud-palette-background-gray, rgba(0,0,0,0.04));
        border-radius: 8px;
        border: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.08));
    }
    .io-summary-chips {
        display: flex;
        align-items: flex-end;
        gap: 10px 14px;
        flex-wrap: wrap;
    }
    .io-summary-chip {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        min-width: 44px;
    }
    .io-summary-chip .mud-icon-root {
        margin: 0;
    }
    .io-summary-chip-label {
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: var(--mud-palette-text-secondary);
        line-height: 1.1;
    }
    .io-mini-map-wrap {
        flex-shrink: 0;
    }
    .io-header-icon-faded {
        color: var(--mud-palette-text-secondary) !important;
        fill: var(--mud-palette-text-secondary) !important;
        opacity: 0.7;
    }
    .io-imports-exports-row {
        margin-bottom: 16px;
    }
    .io-imports-exports-block {
        padding: 12px;
        border-radius: 8px;
        height: 100%;
        background: var(--mud-palette-background-gray, rgba(0,0,0,0.04));
        border: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.08));
    }
    .io-imports-exports-title {
        font-weight: 600;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        color: var(--mud-palette-text-primary);
    }
    .io-imports-exports-empty {
        opacity: 0.7;
        font-style: italic;
    }
    .io-item-list-prominent {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
    }
    .io-imports-exports-block.io-imports .io-item-prominent {
        background: rgba(244, 67, 54, 0.18);
        border: 1px solid rgba(244, 67, 54, 0.35);
    }
    .io-imports-exports-block.io-exports .io-item-prominent {
        background: rgba(76, 175, 80, 0.18);
        border: 1px solid rgba(76, 175, 80, 0.35);
    }
    .io-item-prominent {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background: var(--mud-palette-background-gray, rgba(0,0,0,0.08));
        border-radius: 6px;
        border: 1px solid transparent;
        white-space: nowrap;
        font-size: 0.9375rem;
    }
    .io-item-prominent .io-item-amount {
        font-size: 0.875rem;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }
    .io-meta-blocks {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 20px;
        padding-top: 12px;
        margin-top: 12px;
        border-top: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.12));
    }
    .io-mini-map {
        position: relative;
        width: 72px;
        height: 72px;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.12));
    }
    .io-mini-map-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(0.4) contrast(0.8) brightness(1.1);
        opacity: 0.7;
    }
    .io-mini-map svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }
    .io-meta-block {
        padding: 10px 14px;
        background: var(--mud-palette-background-gray, rgba(0,0,0,0.04));
        border-radius: 8px;
        border: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.08));
    }
    .io-meta-block-label {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 6px;
        display: block;
    }
    .io-meta-block-content {
        font-size: 0.875rem;
    }
    .io-circuit-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
        align-items: center;
    }
    .io-circuit-chip {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        font-size: 0.8125rem;
        font-weight: 500;
        background: var(--mud-palette-background-gray, rgba(0,0,0,0.06));
        border-radius: 6px;
        border: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.08));
        white-space: nowrap;
    }
    .io-meta-block-empty {
        opacity: 0.7;
        font-style: italic;
    }
    .io-meta-block-machines .io-machines-list {
        margin-top: 0;
    }
    .io-machines-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 12px;
        align-items: center;
    }
    .io-machine-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: var(--mud-palette-background-gray, rgba(0,0,0,0.06));
        border-radius: 6px;
        border: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.08));
        white-space: nowrap;
        font-size: 0.8125rem;
    }
    .io-machine-chip-icon {
        width: 22px;
        height: 22px;
        object-fit: contain;
        flex-shrink: 0;
    }
    .io-machine-chip-icon-fallback {
        display: inline-block;
        width: 22px;
        height: 22px;
        border-radius: 4px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
    }
    .io-machine-chip-text {
        font-weight: 500;
    }
    .io-machine-chip-more {
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary);
        padding: 2px 8px;
    }
    .io-transport-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .io-transport-row {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.875rem;
    }
    .io-transport-row .mud-icon-root {
        font-size: 1.1rem;
    }
    .io-transport-name {
        color: var(--mud-palette-text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .io-item-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
    }
    .io-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
        background: var(--mud-palette-background-gray, rgba(0,0,0,0.08));
        border-radius: 4px;
        white-space: nowrap;
    }
    .io-item-icon {
        width: 20px;
        height: 20px;
        object-fit: contain;
        flex-shrink: 0;
    }
    .io-item-icon-fallback {
        display: inline-block;
        border-radius: 2px;
        border: 1px solid rgba(255,255,255,0.2);
    }
    .io-item-text {
        font-size: 0.875rem;
    }
    .io-item-amount {
        font-size: 0.8125rem;
        opacity: 0.9;
        font-variant-numeric: tabular-nums;
    }
    .io-details-panels {
        margin-top: 12px;
    }
    .io-details-panels ::deep .mud-expansion-panel,
    .io-details-panels ::deep .mud-expand-panel {
        background: var(--mud-palette-background-gray, rgba(0,0,0,0.04));
        border: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.08));
        border-radius: 8px;
        box-shadow: none;
    }
    .io-details-panels ::deep .mud-expand-panel-header,
    .io-details-panels ::deep .mud-panel-header {
        padding: 10px 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary);
        min-height: auto;
    }
    .io-details-panels ::deep .mud-expand-panel-content,
    .io-details-panels ::deep .mud-panel-content {
        padding: 10px 14px;
        border-top: 1px solid var(--mud-palette-lines-default, rgba(0,0,0,0.08));
    }
    .io-details-panel {
