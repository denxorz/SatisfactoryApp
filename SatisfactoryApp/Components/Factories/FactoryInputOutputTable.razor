@using Denxorz.Satisfactory.Routes.Types
@using MudBlazor
@using SatisfactoryApp.Services.Factories
@using SatisfactoryApp.Services.Stations
@using SatisfactoryApp.Utils
@inject FactoryStore FactoryStore
@inject StationStore StationStore
@implements IDisposable

<MudStack Spacing="2">
            @foreach (var group in _groupedStats)
            {
                <MudCard Outlined="true" Square="true" Class="border-solid border-4 mud-border-primary">
                    <MudCardHeader Class="mud-primary pa-0 pl-1">
                        <MudText Class="primary-card-header-title" Color="Color.Surface">@GetGroupTitle(group.Key)</MudText>
                    </MudCardHeader>
                    <MudCardContent Class="pa-2">
                        <MudText Typo="Typo.caption" Class="mb-2">
                            <MudText Color="Color.Secondary">Included circuits:</MudText> @GetGroupDisplayName(group.Key)
                        </MudText>
                        @{
                            var netDeficitItems = group.Where(s => s.Net < -0.001).OrderBy(s => s.ItemName).ToList();
                            var netSurplusItems = group.Where(s => s.Net > 0.001).OrderBy(s => s.ItemName).ToList();
                        }
                        @if (netDeficitItems.Any() || netSurplusItems.Any())
                        {
                            <MudStack Spacing="1" Class="mb-2">
                                @if (netDeficitItems.Any())
                                {
                                    <MudText Typo="Typo.body2">
                                        <MudText Color="Color.Error" Typo="Typo.caption">Consumed:</MudText>
                                        @foreach (var s in netDeficitItems)
                                        {
                                            <span class="resource-list-item">
                                                <span class="resource-icon" style="background: @GetItemColor(s.ItemName);" title="@s.ItemName"></span>
                                                <span>@s.ItemName @(Math.Round(-s.Net, 3).ToString("0.###"))</span>
                                            </span>
                                        }
                                    </MudText>
                                }
                                @if (netSurplusItems.Any())
                                {
                                    <MudText Typo="Typo.body2">
                                        <MudText Color="Color.Success" Typo="Typo.caption">Produced:</MudText>
                                        @foreach (var s in netSurplusItems)
                                        {
                                            <span class="resource-list-item">
                                                <span class="resource-icon" style="background: @GetItemColor(s.ItemName);" title="@s.ItemName"></span>
                                                <span>@s.ItemName @(Math.Round(s.Net, 3).ToString("0.###"))</span>
                                            </span>
                                        }
                                    </MudText>
                                }
                            </MudStack>
                        }
                        <MudExpansionPanels Class="mt-2">
                            <MudExpansionPanel Text="Production details" IsInitiallyExpanded="false">
                                <MudTable Items="@group" Hover Dense Striped Breakpoint="Breakpoint.Sm" Class="mud-table-dense">
                            <HeaderContent>
                                <MudTh>Item</MudTh>
                                <MudTh Style="text-align: right">Consumed</MudTh>
                                <MudTh Style="text-align: right">Produced</MudTh>
                                <MudTh Style="text-align: right">Net</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Item">@context.ItemName</MudTd>
                                <MudTd DataLabel="Consumed" Style="text-align: right">
                                    <MudText Color="@(-context.TotalConsumed < -0.001 ? Color.Error : Color.Default)">
                                        @(Math.Round(-context.TotalConsumed, 3).ToString("0.###"))
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="Produced" Style="text-align: right">
                                    @(Math.Round(context.TotalProduced, 3).ToString("0.###"))
                                </MudTd>
                                <MudTd DataLabel="Net" Style="text-align: right">
                                    @{
                                        var net = Math.Round(context.Net, 3);
                                    }
                                    <MudText Color="@(context.Net < -0.001 ? Color.Error : context.Net > 0.001 ? Color.Success : Color.Default)">
                                        @(net == 0 ? "0" : net.ToString("0.###"))
                                    </MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudCardContent>
                </MudCard>
            }
        </MudStack>

<style>
    .resource-list-item {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-right: 12px;
        white-space: nowrap;
    }
    .resource-icon {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 2px;
        flex-shrink: 0;
        border: 1px solid rgba(255,255,255,0.2);
    }
</style>

@code {
    private List<CircuitInputOutputStat> _circuitInputOutputStats = [];
    private Dictionary<int, PowerCircuitStat> _powerMainCircuitStats = [];
    private IGrouping<string, CircuitInputOutputStat>[] _groupedStats = [];


    protected override void OnInitialized()
    {
        FactoryStore.FactoriesChanged += UpdateStats;
        StationStore.StationsChanged += UpdateStats;
        UpdateStats();
    }

    public void Dispose()
    {
        FactoryStore.FactoriesChanged -= UpdateStats;
        StationStore.StationsChanged -= UpdateStats;
    }

    private void UpdateStats()
    {
        var mainCircuitStats = new Dictionary<int, PowerCircuitStat>();
        var circuitItemStats = new Dictionary<(int CircuitId, string ItemName), (double Consumed, double Produced)>();

        foreach (var circuit in FactoryStore.PowerCircuits)
        {
            if (circuit.ParentCircuitId is null)
            {
                mainCircuitStats[circuit.Id] = new PowerCircuitStat
                {
                    CircuitId = circuit.Id,
                    CircuitName = CircuitNames.GetName(circuit)
                };
            }
        }

        foreach (var factory in FactoryStore.Factories)
        {
            var clockSpeedMultiplier = (factory.ClockSpeed ?? 100) / 100;
            var sloopMultiplier = factory.HasSloop ? 2.0 : 1.0;
            var totalMultiplier = clockSpeedMultiplier * sloopMultiplier;

            var circuitsToProcess = new List<int>();

            circuitsToProcess.Add(factory.MainPowerCircuitId);
            circuitsToProcess.Add(factory.SubPowerCircuitId);

            foreach (var circuitId in circuitsToProcess)
            {
                foreach (var consumed in factory.Input)
                {
                    var itemName = GetItemName(consumed);
                    var amount = GetItemAmount(consumed) * totalMultiplier;

                    var key = (circuitId, itemName);
                    if (!circuitItemStats.ContainsKey(key))
                    {
                        circuitItemStats[key] = (0, 0);
                    }
                    var current = circuitItemStats[key];
                    circuitItemStats[key] = (current.Consumed + amount, current.Produced);
                }

                foreach (var output in factory.Output)
                {
                    var itemName = GetItemName(output);
                    var amount = GetItemAmount(output) * totalMultiplier;

                    var key = (circuitId, itemName);
                    if (!circuitItemStats.ContainsKey(key))
                    {
                        circuitItemStats[key] = (0, 0);
                    }
                    var current = circuitItemStats[key];
                    circuitItemStats[key] = (current.Consumed, current.Produced + amount);
                }
            }
        }

        var subCircuitIdByCleanedName = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var circuit in FactoryStore.PowerCircuits)
        {
            if (circuit.ParentCircuitId is null) continue;
            var cleaned = RemoveBrackets(CircuitNames.GetName(circuit)).Trim();
            if (string.IsNullOrEmpty(cleaned)) continue;
            if (!subCircuitIdByCleanedName.ContainsKey(cleaned))
                subCircuitIdByCleanedName[cleaned] = circuit.Id;
        }

        foreach (var station in StationStore.Stations)
        {
            if (station?.CargoFlows == null || station.CargoFlows.Count == 0)
                continue;

            var stationName = (station.Name ?? "").Trim();
            var stationShortName = (station.ShortName ?? "").Trim();
            if (string.IsNullOrEmpty(stationName) && string.IsNullOrEmpty(stationShortName))
                continue;

            if (!subCircuitIdByCleanedName.TryGetValue(stationName, out var circuitId)
                && !subCircuitIdByCleanedName.TryGetValue(stationShortName, out circuitId))
                continue;

            foreach (var flow in station.CargoFlows)
            {
                if (flow == null || string.IsNullOrEmpty(flow.Type) || !flow.FlowPerMinute.HasValue)
                    continue;
                var itemName = flow.Type;
                var amount = flow.FlowPerMinute.Value;
                var key = (circuitId, itemName);
                if (!circuitItemStats.ContainsKey(key))
                    circuitItemStats[key] = (0, 0);
                var current = circuitItemStats[key];
                if (flow.IsUnload)
                    circuitItemStats[key] = (current.Consumed, current.Produced + amount);
                else
                    circuitItemStats[key] = (current.Consumed + amount, current.Produced);
            }
        }

        _powerMainCircuitStats = mainCircuitStats;

        var combinedStats = new Dictionary<(string GroupKey, string ItemName), (double Consumed, double Produced, int? FirstCircuitId, int? ParentCircuitId, bool IsMainCircuit)>();
        
        foreach (var kvp in circuitItemStats)
        {
            var (circuitId, itemName) = kvp.Key;
            var (consumed, produced) = kvp.Value;
            var circuit = FactoryStore.PowerCircuits.FirstOrDefault(c => c.Id == circuitId);
            var parentId = circuit?.ParentCircuitId;
            var isMainCircuit = parentId is null;

            string groupKey;
            if (isMainCircuit)
            {
                groupKey = $"MAIN_{circuitId}";
            }
            else
            {
                var circuitName = CircuitNames.GetName(circuit);
                var cleanedName = RemoveBrackets(circuitName);
                groupKey = $"SUB_{cleanedName}";
            }

            var combinedKey = (groupKey, itemName);
            if (!combinedStats.ContainsKey(combinedKey))
            {
                combinedStats[combinedKey] = (0, 0, circuitId, parentId, isMainCircuit);
            }
            var current = combinedStats[combinedKey];
            combinedStats[combinedKey] = (current.Consumed + consumed, current.Produced + produced, current.FirstCircuitId, current.ParentCircuitId, current.IsMainCircuit);
        }

        _circuitInputOutputStats = combinedStats
            .Select(kvp =>
            {
                var ((groupKey, itemName), (consumed, produced, firstCircuitId, parentId, isMainCircuit)) = kvp;
                var circuit = FactoryStore.PowerCircuits.FirstOrDefault(c => c.Id == firstCircuitId);

                return new CircuitInputOutputStat
                {
                    CircuitId = firstCircuitId ?? 0,
                    CircuitName = isMainCircuit ? CircuitNames.GetName(circuit) : RemoveBrackets(CircuitNames.GetName(circuit)),
                    ParentCircuitId = parentId,
                    ItemName = itemName,
                    TotalConsumed = consumed,
                    TotalProduced = produced,
                    GroupKey = groupKey,
                    IsMainCircuit = isMainCircuit
                };
            })
            .OrderBy(s => s.IsMainCircuit ? 0 : 1)
            .ThenBy(s => s.GroupKey)
            .ThenBy(s => s.ItemName)
            .ToList();

        var mainCircuitSubCount = new Dictionary<int, int>();
        foreach (var c in FactoryStore.PowerCircuits)
        {
            if (c.ParentCircuitId is int parentId)
                mainCircuitSubCount[parentId] = mainCircuitSubCount.GetValueOrDefault(parentId, 0) + 1;
        }

        _groupedStats = _circuitInputOutputStats
            .Where(s => !s.IsMainCircuit || mainCircuitSubCount.GetValueOrDefault(s.CircuitId, 0) <= 1)
            .GroupBy(s => s.GroupKey)
            .OrderBy(g => _circuitInputOutputStats.First(x => x.GroupKey == g.Key).IsMainCircuit ? 0 : 1)
            .ThenBy(g => g.Key)
            .ToArray();

        StateHasChanged();
    }

    private string GetGroupDisplayName(string groupKey)
    {
        if (groupKey.StartsWith("MAIN_"))
        {
            var circuitId = int.Parse(groupKey.Substring(5));
            var mainCircuit = _powerMainCircuitStats.GetValueOrDefault(circuitId);
            return mainCircuit != null ? $"[{mainCircuit.CircuitId}] {mainCircuit.CircuitName}" : "[Unknown Main Circuit]";
        }
        if (groupKey.StartsWith("SUB_"))
        {
            var cleanedName = groupKey.Substring(4);
            var subCircuits = FactoryStore.PowerCircuits
                .Where(c => c.ParentCircuitId is not null && RemoveBrackets(CircuitNames.GetName(c)) == cleanedName)
                .ToList();
            return subCircuits.Any()
                ? string.Join(", ", subCircuits.Select(c => CircuitNames.GetIdAndName(c)))
                : cleanedName;
        }
        return "[Unknown Circuit]";
    }

    private string GetGroupTitle(string groupKey)
    {
        string? title = null;
        if (groupKey.StartsWith("MAIN_"))
        {
            var circuitId = int.Parse(groupKey.Substring(5));
            var mainCircuit = _powerMainCircuitStats.GetValueOrDefault(circuitId);
            title = mainCircuit?.CircuitName;
        }
        else if (groupKey.StartsWith("SUB_"))
        {
            title = groupKey.Substring(4);
        }
        return string.IsNullOrWhiteSpace(title) ? "Unknown" : title;
    }

    private string GetItemName(FactoryFlow flow)
    {
        return flow.Type;
    }

    private double GetItemAmount(FactoryFlow flow)
    {
        return flow.FlowPerMinute ?? 0;
    }

    private string RemoveBrackets(string name)
    {
        if (string.IsNullOrEmpty(name))
            return name;

        var result = System.Text.RegularExpressions.Regex.Replace(name, @"\s*\[.*?\]\s*", " ");
        return System.Text.RegularExpressions.Regex.Replace(result, @"\s+", " ").Trim();
    }

    private static string GetItemColor(string itemName)
    {
        if (string.IsNullOrEmpty(itemName)) return "#FF0000";
        var key = itemName.Replace(" ", "").ToLowerInvariant();
        return CargoColors.GetCargoColor(key);
    }

    private sealed class CircuitInputOutputStat
    {
        public int CircuitId { get; set; }
        public string CircuitName { get; set; } = string.Empty;
        public int? ParentCircuitId { get; set; }
        public string ItemName { get; set; } = string.Empty;
        public double TotalConsumed { get; set; }
        public double TotalProduced { get; set; }
        public double Net => TotalProduced - TotalConsumed;
        public string GroupKey { get; set; } = string.Empty;
        public bool IsMainCircuit { get; set; }
    }

    private sealed class PowerCircuitStat
    {
        public int CircuitId { get; set; }
        public string CircuitName { get; set; } = string.Empty;
    }
}
